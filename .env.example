# GitHub fine-grained PAT with Contents: Read on the scripts repo.
# Used to clone/pull the private scripts repo. Redacted in all TUI output.
GITHUB_TOKEN=

# HTTPS URL of the private scripts repo (overrides legacy scriptsRepo in config.json)
# SCRIPTS_REPO=https://github.com/YOUR_ORG/your-scripts-repo

# Optional: n8n webhook endpoint (overrides n8nWebhookUrl in config.json)
# N8N_WEBHOOK_URL=

# Optional: enables plain-English -> cron conversion when scheduling (e key)
# OPENROUTER_API_KEY=

# Optional: API key for custom 9router/OpenAI-compatible aiEndpoint in config.json.
# AI_API_KEY=

# Regular install.sh registers the MCP/API service, including when disabled.
# Unset enables legacy installs only when MCP_AUTH_TOKEN is nonempty.
# false: --mcp exits without listening; --restart stops the installed service.
# true: --restart starts/restarts it; regular install also starts it.
# Does not start services on ordinary TUI launch. Apply edits: scriptorium --restart
MCP_ENABLED=false

# Required to start the MCP server (scriptorium --mcp): shared Bearer token the
# n8n MCP Client credential must present. Generate one: openssl rand -hex 32
# MCP_AUTH_TOKEN=
